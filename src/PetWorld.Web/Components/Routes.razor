<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            <div class="page page-narrow">
                <h1 class="text-headline-lg">404 — nie znaleziono strony</h1>
                <p class="muted mt-sm">Strona, której szukasz, nie istnieje.</p>
                <a class="btn btn-primary mt-md" href="/">Wróć na stronę główną</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>
