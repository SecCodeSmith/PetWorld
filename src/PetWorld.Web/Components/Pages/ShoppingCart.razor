@page "/koszyk"
@rendermode InteractiveServer
@inject ICartService Cart

<PageTitle>Koszyk — PetWorld</PageTitle>

<div class="page">
    <h1 class="text-headline-lg mb-md">Twój koszyk</h1>

    @if (_checkedOut)
    {
        <div class="card p-md empty-state">
            <Icon Name="check" Size="64" Class="text-primary" />
            <h2 class="text-headline-md">Dziękujemy za zamówienie!</h2>
            <p class="muted">To wersja demonstracyjna — płatność nie jest realizowana. Twój koszyk został wyczyszczony.</p>
            <a class="btn btn-primary" href="/sklep">Kontynuuj zakupy</a>
        </div>
    }
    else if (_cart.IsEmpty)
    {
        <div class="card p-md empty-state">
            <Icon Name="cart" Size="64" Class="text-outline-variant" />
            <h2 class="text-headline-md">Twój koszyk jest pusty</h2>
            <p class="muted">Dodaj produkty ze sklepu, aby kontynuować.</p>
            <a class="btn btn-primary" href="/sklep">Przejdź do sklepu</a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-gutter items-start">
            <div class="flex flex-col gap-md">
                @foreach (var line in _cart.Lines)
                {
                    <article class="card flex gap-md items-center p-md" @key="line.ProductId">
                        <div class="w-24 h-24 rounded-control bg-surface-low flex items-center justify-center text-primary-container shrink-0">
                            <Icon Name="paw" Size="44" Class="opacity-60" />
                        </div>
                        <div class="flex-1 flex flex-col gap-1">
                            <div class="flex items-start justify-between gap-md">
                                <div>
                                    <span class="text-label-md text-primary uppercase">@line.Category</span>
                                    <h3 class="text-body-lg font-semibold">@line.Name</h3>
                                    <p class="muted text-sm">Cena jedn.: @PriceFormatter.ToZl(line.UnitPrice)</p>
                                </div>
                                <button class="icon-btn hover:text-error" aria-label="Usuń przedmiot" @onclick="() => Remove(line.ProductId)">
                                    <Icon Name="trash" Size="20" />
                                </button>
                            </div>
                            <div class="flex items-center justify-between gap-md mt-1">
                                <QuantityStepper Value="line.Quantity"
                                                 ValueChanged="q => SetQuantity(line.ProductId, q)" />
                                <span class="text-xl font-bold text-primary whitespace-nowrap">@PriceFormatter.ToZl(line.LineTotal)</span>
                            </div>
                        </div>
                    </article>
                }
            </div>

            <aside class="card p-md lg:sticky lg:top-[88px]">
                <h2 class="text-headline-md border-b border-surface-highest pb-sm mb-md">Podsumowanie</h2>
                <div class="flex justify-between text-on-surface-variant mb-sm">
                    <span>Suma częściowa</span>
                    <span>@PriceFormatter.ToZl(_cart.Subtotal)</span>
                </div>
                <div class="flex justify-between text-on-surface-variant mb-sm">
                    <span>Dostawa (Kurier)</span>
                    <span>@PriceFormatter.ToZl(_cart.Shipping)</span>
                </div>
                <div class="flex justify-between items-center border-t border-surface-highest pt-sm mt-sm mb-md">
                    <span class="text-body-lg font-semibold">Razem</span>
                    <span class="text-[28px] font-bold text-primary">@PriceFormatter.ToZl(_cart.Total)</span>
                </div>
                <button class="btn btn-primary btn-block btn-lg" @onclick="Checkout">
                    Przejdź do kasy <Icon Name="arrow-right" Size="18" />
                </button>
                <a class="btn btn-secondary btn-block btn-lg mt-md" href="/sklep">Kontynuuj zakupy</a>
                <div class="flex items-center justify-center gap-2 text-on-surface-variant text-[13px] mt-md">
                    <Icon Name="lock" Size="14" /> Bezpieczne płatności SSL
                </div>
            </aside>
        </div>
    }
</div>

@code {
    private CartView _cart = new();
    private bool _checkedOut;

    protected override void OnInitialized() => Refresh();

    private void Refresh() => _cart = Cart.GetCart();

    private void SetQuantity(int productId, int quantity)
    {
        Cart.UpdateQuantity(productId, quantity);
        Refresh();
    }

    private void Remove(int productId)
    {
        Cart.Remove(productId);
        Refresh();
    }

    private void Checkout()
    {
        // Stub: no payment. Confirm the order and clear the in-memory cart.
        Cart.Clear();
        Refresh();
        _checkedOut = true;
    }
}
