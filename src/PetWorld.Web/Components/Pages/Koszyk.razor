@page "/koszyk"
@rendermode InteractiveServer
@inject ICartService Cart

<PageTitle>Koszyk — PetWorld</PageTitle>

<div class="page">
    <h1 class="headline-lg mb-md">Twój koszyk</h1>

    @if (_checkedOut)
    {
        <div class="card card--pad empty-state">
            <Icon Name="check" Size="64" />
            <h2 class="headline-md">Dziękujemy za zamówienie!</h2>
            <p class="muted">To wersja demonstracyjna — płatność nie jest realizowana. Twój koszyk został wyczyszczony.</p>
            <a class="btn btn--primary" href="/sklep">Kontynuuj zakupy</a>
        </div>
    }
    else if (_cart.IsEmpty)
    {
        <div class="card card--pad empty-state">
            <Icon Name="cart" Size="64" />
            <h2 class="headline-md">Twój koszyk jest pusty</h2>
            <p class="muted">Dodaj produkty ze sklepu, aby kontynuować.</p>
            <a class="btn btn--primary" href="/sklep">Przejdź do sklepu</a>
        </div>
    }
    else
    {
        <div class="cart-layout">
            <div class="cart-items">
                @foreach (var line in _cart.Lines)
                {
                    <article class="card cart-item" @key="line.ProductId">
                        <div class="cart-item__media"><Icon Name="paw" Size="44" /></div>
                        <div class="cart-item__body">
                            <div class="flex-between">
                                <div>
                                    <span class="label" style="color:var(--primary)">@line.Category</span>
                                    <h3 class="body-lg" style="font-weight:600">@line.Name</h3>
                                    <p class="muted" style="font-size:14px">Cena jedn.: @PriceFormatter.ToZl(line.UnitPriceGr)</p>
                                </div>
                                <button class="icon-btn" aria-label="Usuń przedmiot" @onclick="() => Remove(line.ProductId)">
                                    <Icon Name="trash" Size="20" />
                                </button>
                            </div>
                            <div class="cart-item__foot">
                                <QuantityStepper Value="line.Quantity"
                                                 ValueChanged="q => SetQuantity(line.ProductId, q)" />
                                <span class="cart-item__price">@PriceFormatter.ToZl(line.LineTotalGr)</span>
                            </div>
                        </div>
                    </article>
                }
            </div>

            <aside class="card summary">
                <h2 class="headline-md">Podsumowanie</h2>
                <div class="summary__row">
                    <span>Suma częściowa</span>
                    <span>@PriceFormatter.ToZl(_cart.SubtotalGr)</span>
                </div>
                <div class="summary__row">
                    <span>Dostawa (Kurier)</span>
                    <span>@PriceFormatter.ToZl(_cart.ShippingGr)</span>
                </div>
                <div class="summary__total">
                    <span class="body-lg" style="font-weight:600">Razem</span>
                    <span class="total-amount">@PriceFormatter.ToZl(_cart.TotalGr)</span>
                </div>
                <button class="btn btn--primary btn--block btn--lg" @onclick="Checkout">
                    Przejdź do kasy <Icon Name="arrow-right" Size="18" />
                </button>
                <a class="btn btn--secondary btn--block btn--lg mt-md" href="/sklep">Kontynuuj zakupy</a>
                <div class="row text-center muted mt-md" style="justify-content:center; font-size:13px">
                    <Icon Name="lock" Size="14" /> Bezpieczne płatności SSL
                </div>
            </aside>
        </div>
    }
</div>

@code {
    private CartView _cart = new();
    private bool _checkedOut;

    protected override void OnInitialized() => Refresh();

    private void Refresh() => _cart = Cart.GetCart();

    private void SetQuantity(int productId, int quantity)
    {
        Cart.UpdateQuantity(productId, quantity);
        Refresh();
    }

    private void Remove(int productId)
    {
        Cart.Remove(productId);
        Refresh();
    }

    private void Checkout()
    {
        // Stub: no payment. Confirm the order and clear the in-memory cart.
        Cart.Clear();
        Refresh();
        _checkedOut = true;
    }
}
