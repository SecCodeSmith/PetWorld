@page "/profil"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@inject IAuthService Auth

<PageTitle>Profil — PetWorld</PageTitle>

<div class="page">
    <h1 class="headline-lg mb-md">Mój profil</h1>

    @if (_profile is null)
    {
        <p class="muted">Ładowanie…</p>
    }
    else
    {
        <div class="profile-layout">
            <aside class="card profile-sidebar">
                <span class="avatar">@Initial</span>
                <strong>@(string.IsNullOrWhiteSpace(_profile.DisplayName) ? _profile.Email : _profile.DisplayName)</strong>
                <span class="muted" style="font-size:14px">@_profile.Email</span>
                <div class="profile-nav">
                    <span class="chip chip--active"><Icon Name="user" Size="16" /> Dane konta</span>
                </div>
            </aside>

            <section class="card card--pad">
                <h2 class="headline-md mb-md">Dane konta</h2>

                @if (_saved)
                {
                    <div class="success-box mb-md">Zapisano zmiany.</div>
                }
                @if (_error is not null)
                {
                    <div class="form-error-box mb-md">@_error</div>
                }

                <EditForm Model="_profile" OnValidSubmit="SaveAsync">
                    <DataAnnotationsValidator />
                    <div class="form-grid">
                        <div class="field">
                            <label for="displayName">Imię i nazwisko</label>
                            <InputText id="displayName" class="input" @bind-Value="_profile.DisplayName" />
                        </div>
                        <div class="field">
                            <label for="phone">Telefon</label>
                            <InputText id="phone" class="input" @bind-Value="_profile.PhoneNumber" />
                        </div>
                    </div>
                    <div class="field">
                        <label for="email">Adres e-mail</label>
                        <input id="email" class="input" value="@_profile.Email" disabled />
                    </div>
                    <button type="submit" class="btn btn--primary btn--lg mt-md">Zapisz zmiany</button>
                </EditForm>
            </section>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private AccountProfile? _profile;
    private string? _userId;
    private bool _saved;
    private string? _error;

    private string Initial =>
        string.IsNullOrWhiteSpace(_profile?.DisplayName)
            ? (_profile?.Email.Length > 0 ? _profile.Email[..1].ToUpperInvariant() : "?")
            : _profile.DisplayName[..1].ToUpperInvariant();

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null)
        {
            return;
        }

        var state = await AuthState;
        _userId = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (_userId is not null)
        {
            _profile = await Auth.GetProfileAsync(_userId);
        }

        _profile ??= new AccountProfile();
    }

    private async Task SaveAsync()
    {
        _saved = false;
        _error = null;

        if (_userId is null || _profile is null)
        {
            return;
        }

        var result = await Auth.UpdateProfileAsync(_userId, _profile);
        if (result.Succeeded)
        {
            _saved = true;
        }
        else
        {
            _error = result.Error;
        }
    }
}
