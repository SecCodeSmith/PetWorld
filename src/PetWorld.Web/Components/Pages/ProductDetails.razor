@page "/produkt/{Id:int}"
@rendermode InteractiveServer
@inject IProductRepository Products
@inject ICartService Cart
@inject NavigationManager Nav

<PageTitle>@(_product?.Name ?? "Produkt") — PetWorld</PageTitle>

<div class="page">
    @if (_loaded && _product is null)
    {
        <h1 class="text-headline-lg">Nie znaleziono produktu</h1>
        <p class="muted mt-sm mb-md">Ten produkt nie istnieje lub został usunięty.</p>
        <a class="btn btn-primary" href="/sklep">Wróć do sklepu</a>
    }
    else if (_product is not null)
    {
        <nav class="flex items-center gap-2 text-sm text-on-surface-variant mb-md">
            <a class="hover:text-primary" href="/sklep"><Icon Name="home" Size="16" /></a>
            <Icon Name="chevron-right" Size="14" />
            <a class="hover:text-primary" href="/sklep">Sklep</a>
            <Icon Name="chevron-right" Size="14" />
            <span class="text-on-surface">@_product.Category</span>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-lg">
            <div class="bg-white rounded-card shadow-card aspect-square flex items-center justify-center text-primary-container relative overflow-hidden">
                <Icon Name="paw" Size="160" Class="opacity-50" />
            </div>
            <div class="flex flex-col gap-sm">
                <span class="pill self-start"><Icon Name="tag" Size="14" /> @_product.Category</span>
                <h1 class="text-headline-lg">@_product.Name</h1>
                <span class="text-[32px] font-bold text-primary">@PriceFormatter.ToZl(_product.Price)</span>
                <p class="muted">@_product.Description</p>

                <div class="flex gap-sm items-center flex-wrap mt-sm">
                    <QuantityStepper @bind-Value="_quantity" />
                    <button class="btn btn-primary btn-lg" @onclick="AddToCart">
                        <Icon Name="cart" Size="18" /> Dodaj do koszyka
                    </button>
                    <button class="btn btn-secondary btn-lg" @onclick="BuyNow">Kup teraz</button>
                </div>

                @if (_added)
                {
                    <div class="success-box">Dodano do koszyka (@_quantity szt.).</div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private Product? _product;
    private bool _loaded;
    private int _quantity = 1;
    private bool _added;

    protected override async Task OnParametersSetAsync()
    {
        _product = await Products.GetByIdAsync(Id);
        _loaded = true;
    }

    private async Task AddToCart()
    {
        if (_product is null)
        {
            return;
        }

        await Cart.AddAsync(_product.Id, _quantity);
        _added = true;
    }

    private async Task BuyNow()
    {
        if (_product is null)
        {
            return;
        }

        await Cart.AddAsync(_product.Id, _quantity);
        Nav.NavigateTo("/koszyk");
    }
}
