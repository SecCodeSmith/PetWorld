@inject ICartService Cart

<div class="product-card">
    <a class="h-[150px] rounded-control bg-surface-low flex items-center justify-center text-primary-container overflow-hidden"
       href="@Url" aria-label="@Product.Name">
        <Icon Name="paw" Size="64" Class="opacity-60" />
    </a>
    <div class="flex flex-col gap-0.5 flex-1">
        <a class="text-[18px] font-semibold text-on-surface" href="@Url">@Product.Name</a>
        <span class="text-[13px] text-on-surface-variant">@Product.Category</span>
    </div>
    <div class="flex items-center justify-between mt-auto pt-base">
        <span class="text-xl font-bold text-primary">@PriceFormatter.ToZl(Product.PriceGr)</span>
        <button class="btn btn-primary" @onclick="AddAsync">@AddLabel</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Product Product { get; set; } = default!;
    [Parameter] public string AddLabel { get; set; } = "Do koszyka";
    [Parameter] public EventCallback OnAdded { get; set; }

    private string Url => $"/produkt/{Product.Id}";

    private async Task AddAsync()
    {
        await Cart.AddAsync(Product.Id);
        if (OnAdded.HasDelegate)
        {
            await OnAdded.InvokeAsync();
        }
    }
}
