# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# docker compose reads these automatically.

# ---- OpenAI (required for the advisor / chat) ----
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-replace-with-your-openai-key

# Chat model used by the Writer/Critic agents (optional; defaults to gpt-4o-mini).
# For a local server, set this to whatever model id it serves (e.g. a local GGUF name).
AI__MODEL=gpt-4o-mini

# ---- Optional: local OpenAI-compatible LLM server (for testing without OpenAI) ----
# Point the advisor at a local server that speaks the OpenAI API. Include the /v1 suffix.
# Leave empty to use the real OpenAI API.
#   LM Studio:  http://localhost:1234/v1     (from Docker: http://host.docker.internal:1234/v1)
#   Ollama:     http://localhost:11434/v1    (from Docker: http://host.docker.internal:11434/v1)
#   llama.cpp:  http://localhost:8080/v1     vLLM: http://localhost:8000/v1
# When AI__BASEURL is set, OPENAI_API_KEY may be any non-empty placeholder (local servers ignore it).
AI__BASEURL=

# ---- MySQL credentials (used by the db service and the web connection string) ----
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_DATABASE=petworld
MYSQL_USER=petworld
MYSQL_PASSWORD=replace-with-strong-app-password

# ---- Seeded demo user (ASP.NET Core Identity) ----
# Created on startup so you can log in immediately. Change before any real use.
SEED_USER_EMAIL=demo@petworld.local
SEED_USER_PASSWORD=Demo123!ChangeMe
